@page
@model MurendeniConstructionArchitects.Pages.Admin.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<h1>Change Password</h1>

@if (Model.SuccessMessage != null)
{
    <div class="admin-alert-success">@Model.SuccessMessage</div>
}

<div asp-validation-summary="ModelOnly"></div>

<form method="post" style="max-width:420px;">
    <div class="admin-form-field">
        <label asp-for="Input.CurrentPassword">Current Password</label>
        <input asp-for="Input.CurrentPassword" type="password" />
        <span asp-validation-for="Input.CurrentPassword"></span>
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.NewPassword">New Password</label>
        <input asp-for="Input.NewPassword" type="password" />
        <span asp-validation-for="Input.NewPassword"></span>
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.ConfirmNewPassword">Confirm New Password</label>
        <input asp-for="Input.ConfirmNewPassword" type="password" />
        <span asp-validation-for="Input.ConfirmNewPassword"></span>
    </div>

    <button type="submit" class="admin-btn admin-btn-accent">Update Password</button>
</form>