@page
@model MurendeniConstructionArchitects.Pages.Admin.AddProjectModel
@{
    ViewData["Title"] = "Add Project";
}

<h1>Add Project</h1>

<div asp-validation-summary="ModelOnly"></div>

<form method="post">
    <div class="admin-form-field">
        <label asp-for="Input.ClientId">Client</label>
        <select asp-for="Input.ClientId">
            <option value="">Select a client</option>
            @foreach (var client in Model.Clients)
            {
                <option value="@client.ClientId">@client.FullName (@client.Email)</option>
            }
        </select>
        <span asp-validation-for="Input.ClientId"></span>
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.EmployeeId">Assigned Employee</label>
        <select asp-for="Input.EmployeeId">
            <option value="">Select an employee</option>
            @foreach (var employee in Model.Employees)
            {
                <option value="@employee.EmployeeId">@employee.FullName (@employee.Role)</option>
            }
        </select>
        <span asp-validation-for="Input.EmployeeId"></span>
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.ProfileName">Project Name</label>
        <input asp-for="Input.ProfileName" placeholder="e.g. Modern House - Sandton" />
        <span asp-validation-for="Input.ProfileName"></span>
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.PropertyType">Property Type</label>
        <select asp-for="Input.PropertyType">
            <option value="Residential">Residential</option>
            <option value="Commercial">Commercial</option>
        </select>
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.Location">Location</label>
        <input asp-for="Input.Location" placeholder="e.g. Sandton, Johannesburg" />
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.YearCompleted">Year Completed (leave blank if ongoing)</label>
        <input asp-for="Input.YearCompleted" type="number" />
    </div>

    <div class="admin-form-field">
        <label asp-for="Input.Description">Description</label>
        <textarea asp-for="Input.Description"></textarea>
    </div>

    <button type="submit" class="admin-btn admin-btn-accent">Create Project</button>
</form>

<p style="margin-top:20px;"><a href="/Admin/ManageProjects">&laquo; Back to Manage Projects</a></p>