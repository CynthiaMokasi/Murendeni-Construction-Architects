@page
@model MurendeniConstructionArchitects.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login - Murendeni";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>


    <!-- Fonts -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet">


    <!-- Existing site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <style>

            /* =========================================================
                       RESET
                       ========================================================= */

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
            }

            body {
                font-family: "Inter", sans-serif;
                background: #07101d;
                color: #ffffff;
            }


            /* =========================================================
                       NAVIGATION
                       ========================================================= */

            .login-header {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 72px;
                z-index: 1000;
                background: rgba(5, 14, 26, 0.96);
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
            }


            .login-header-inner {
                width: 100%;
                max-width: 1400px;
                height: 100%;
                margin: 0 auto;
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }


            /* Logo */

            .login-logo {
                display: flex;
                align-items: center;
                text-decoration: none;
            }


            .login-logo-image {
                height: 48px;
                width: auto;
                display: block;
                object-fit: contain;
            }


            /* Navigation */

            .login-nav {
                display: flex;
                align-items: center;
                gap: 30px;
            }


                .login-nav a {
                    position: relative;
                    color: #e7ebef;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 500;
                    transition: color 0.2s ease, opacity 0.2s ease;
                }


                    .login-nav a:hover {
                        color: #d3a33d;
                    }


                    /* Navigation underline */

                    .login-nav a:not(.login-nav-login):not(.login-nav-contact)::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        bottom: -7px;
                        width: 0;
                        height: 1px;
                        background: #d3a33d;
                        transition: width 0.25s ease;
                    }


                    .login-nav a:not(.login-nav-login):not(.login-nav-contact):hover::after {
                        width: 100%;
                    }


            /* Login button */

            .login-nav-login {
                padding: 9px 17px;
                border: 1px solid rgba(255, 255, 255, 0.30);
                border-radius: 5px;
            }


                .login-nav-login:hover {
                    border-color: #d3a33d;
                }


            /* Get in touch */

            .login-nav-contact {
                padding: 10px 19px;
                border-radius: 5px;
                background: #c99a38;
                color: #ffffff !important;
                font-weight: 600 !important;
                transition: background 0.2s ease, transform 0.2s ease;
            }


                .login-nav-contact:hover {
                    background: #d9aa48;
                    transform: translateY(-1px);
                }


            /* =========================================================
                       MAIN LOGIN AREA

                       IMPORTANT:
                       There is ONLY ONE background image.
                       The image itself contains the split:
                       blueprint + building.
                       ========================================================= */

            .login-page {
                position: relative;
                min-height: calc(100vh - 72px);
                margin-top: 72px;
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: flex-start;
                overflow: hidden;
                background-image: url('/images/background.png');
                background-position: center center;
                background-size: cover;
                background-repeat: no-repeat;
            }


                /* =========================================================
                       DARK OVERLAY

                       This does NOT create another background.
                       It simply darkens the left portion of the
                       existing background image.
                       ========================================================= */

                .login-page::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    z-index: 1;
                    background: linear-gradient( 90deg, rgba(4, 13, 24, 0.94) 0%, rgba(4, 13, 24, 0.90) 38%, rgba(4, 13, 24, 0.68) 48%, rgba(4, 13, 24, 0.12) 62%, rgba(4, 13, 24, 0.04) 100% );
                    pointer-events: none;
                }


                /* Slight overall darkening */

                .login-page::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    z-index: 2;
                    background: linear-gradient( 180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.12) );
                    pointer-events: none;
                }


            /* =========================================================
                       LOGIN CONTENT
                       ========================================================= */

            .login-content {
                position: relative;
                z-index: 5;
                width: 56%;
                min-height: calc(100vh - 72px);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 50px;
            }


            /* =========================================================
                       LOGIN CARD
                       ========================================================= */

            .login-card {
                width: min(100%, 500px);
                padding: 38px 40px 42px;
                background: linear-gradient( 145deg, rgba(10, 24, 40, 0.96), rgba(5, 16, 29, 0.97) );
                border: 1px solid rgba(135, 158, 181, 0.22);
                border-radius: 14px;
                box-shadow: 0 30px 80px rgba(0, 0, 0, 0.48), inset 0 1px 0 rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
            }


            /* =========================================================
                       LOGO
                       ========================================================= */

            .login-card-logo {
                display: flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 28px;
            }


                .login-card-logo img {
                    height: 92px;
                    width: auto;
                    max-width: 240px;
                    display: block;
                    object-fit: contain;
                }


            /* =========================================================
                       HEADING
                       ========================================================= */

            .login-heading {
                margin: 0;
                text-align: center;
                font-family: "Archivo", sans-serif;
                font-size: 30px;
                line-height: 1.2;
                font-weight: 700;
                color: #ffffff;
                letter-spacing: -0.4px;
            }


            .login-subtext {
                margin: 10px 0 32px;
                text-align: center;
                color: #a5afbb;
                font-size: 14px;
                line-height: 1.5;
            }


            /* =========================================================
                       ERROR MESSAGE
                       ========================================================= */

            .field-error {
                margin-bottom: 20px;
                padding: 12px 14px;
                background: rgba(190, 45, 45, 0.14);
                border: 1px solid rgba(230, 80, 80, 0.45);
                border-radius: 7px;
                color: #ffaaaa;
                font-size: 13px;
            }


            /* =========================================================
                       FORM
                       ========================================================= */

            .login-form {
                display: flex;
                flex-direction: column;
                gap: 20px;
            }


            .form-group {
                display: flex;
                flex-direction: column;
            }


                .form-group label {
                    margin-bottom: 8px;
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 500;
                }


            /* =========================================================
                       INPUT
                       ========================================================= */

            .input-wrapper {
                position: relative;
                width: 100%;
            }


            .form-group input {
                width: 100%;
                height: 56px;
                padding: 0 48px 0 16px;
                background: rgba(255, 255, 255, 0.045);
                border: 1px solid rgba(126, 151, 178, 0.20);
                border-radius: 8px;
                color: #ffffff;
                font-family: "Inter", sans-serif;
                font-size: 14px;
                outline: none;
                transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
            }


                .form-group input::placeholder {
                    color: #6f7c8b;
                }


                .form-group input:focus {
                    border-color: #c99a38;
                    background: rgba(255, 255, 255, 0.06);
                    box-shadow: 0 0 0 3px rgba(201, 154, 56, 0.08);
                }


            /* =========================================================
                       EMAIL ICON
                       ========================================================= */

            .input-icon {
                position: absolute;
                right: 16px;
                top: 50%;
                width: 20px;
                height: 20px;
                transform: translateY(-50%);
                color: #8995a3;
                pointer-events: none;
            }


            /* =========================================================
                       PASSWORD TOGGLE
                       ========================================================= */

            .password-toggle {
                position: absolute;
                right: 13px;
                top: 50%;
                width: 28px;
                height: 28px;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #8995a3;
                cursor: pointer;
            }


                .password-toggle:hover {
                    color: #d3a33d;
                }


            /* =========================================================
                       OPTIONS
                       ========================================================= */

            .form-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 13px;
            }


            .checkbox-label {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #c5ccd4;
                cursor: pointer;
                user-select: none;
            }


                .checkbox-label input {
                    width: 18px;
                    height: 18px;
                    margin: 0;
                    appearance: none;
                    border: 1px solid rgba(255, 255, 255, 0.25);
                    border-radius: 4px;
                    background: rgba(255, 255, 255, 0.05);
                    cursor: pointer;
                    position: relative;
                }


                    .checkbox-label input:checked {
                        background: #d09d35;
                        border-color: #d09d35;
                    }


                        .checkbox-label input:checked::after {
                            content: "";
                            position: absolute;
                            width: 5px;
                            height: 9px;
                            left: 5px;
                            top: 2px;
                            border: solid #ffffff;
                            border-width: 0 2px 2px 0;
                            transform: rotate(45deg);
                        }


            .form-options a {
                color: #d2a03a;
                text-decoration: none;
                transition: color 0.2s ease;
            }


                .form-options a:hover {
                    color: #e6bb5b;
                    text-decoration: underline;
                }


            /* =========================================================
                       LOGIN BUTTON
                       ========================================================= */

            .login-button {
                width: 100%;
                height: 58px;
                margin-top: 2px;
                border: 0;
                border-radius: 8px;
                background: linear-gradient( 135deg, #c8952f, #d5a63f );
                color: #ffffff;
                font-family: "Archivo", sans-serif;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 8px 22px rgba(180, 130, 35, 0.18);
                transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            }


                .login-button:hover {
                    transform: translateY(-1px);
                    background: linear-gradient( 135deg, #d3a33c, #e0b34d );
                    box-shadow: 0 12px 28px rgba(180, 130, 35, 0.25);
                }


                .login-button:active {
                    transform: translateY(0);
                }


            /* =========================================================
                       DIVIDER
                       ========================================================= */

            .login-divider {
                display: flex;
                align-items: center;
                gap: 14px;
                margin: 28px 0 22px;
                color: #7d8996;
                font-size: 13px;
                text-align: center;
            }


                .login-divider::before,
                .login-divider::after {
                    content: "";
                    flex: 1;
                    height: 1px;
                    background: rgba(255, 255, 255, 0.10);
                }


            /* =========================================================
                       SOCIAL BUTTONS
                       ========================================================= */

            .social-buttons {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }


            .social-button {
                height: 52px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                border: 1px solid rgba(201, 154, 56, 0.35);
                border-radius: 7px;
                background: rgba(5, 15, 27, 0.35);
                color: #ffffff;
                font-family: "Inter", sans-serif;
                font-size: 14px;
                font-weight: 500;
                cursor: pointer;
                transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
            }


                .social-button:hover {
                    background: rgba(201, 154, 56, 0.08);
                    border-color: rgba(201, 154, 56, 0.7);
                    transform: translateY(-1px);
                }


            .google-icon {
                font-family: Arial, sans-serif;
                font-size: 18px;
                font-weight: 700;
                background: linear-gradient( 90deg, #4285f4, #34a853, #fbbc05, #ea4335 );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }


            .apple-icon {
                font-size: 18px;
                line-height: 1;
            }


            /* =========================================================
                       SIGN UP
                       ========================================================= */

            .login-signup {
                margin-top: 28px;
                text-align: center;
                color: #9ba5b0;
                font-size: 13px;
            }


                .login-signup a {
                    color: #d2a03a;
                    text-decoration: none;
                    font-weight: 500;
                }


                    .login-signup a:hover {
                        color: #e6bb5b;
                        text-decoration: underline;
                    }


            /* =========================================================
                       RESPONSIVE
                       ========================================================= */

            @@media (max-width: 1100px) {

                .login-header-inner {
                    padding: 0 25px;
                }


                .login-nav {
                    gap: 18px;
                }


                .login-content {
                    width: 60%;
                    padding: 35px;
                }
            }


            @@media (max-width: 900px) {

                .login-header {
                    height: 68px;
                }


                .login-page {
                    margin-top: 68px;
                    min-height: calc(100vh - 68px);
                    background-position: center;
                }


                .login-header-inner {
                    padding: 0 20px;
                }


                .login-nav {
                    gap: 12px;
                }


                    .login-nav a:not(.login-nav-login):not(.login-nav-contact) {
                        display: none;
                    }


                .login-nav-login {
                    padding: 8px 14px;
                }


                .login-nav-contact {
                    padding: 9px 14px;
                }


                .login-content {
                    width: 100%;
                    min-height: calc(100vh - 68px);
                    padding: 30px 20px;
                }


                .login-page::before {
                    background: linear-gradient( 90deg, rgba(4, 13, 24, 0.92), rgba(4, 13, 24, 0.80) );
                }
            }


            @@media (max-width: 600px) {

                .login-logo-image {
                    height: 42px;
                }


                .login-nav-contact {
                    display: none;
                }


                .login-content {
                    padding: 20px 15px;
                }


                .login-card {
                    padding: 30px 22px 32px;
                    border-radius: 12px;
                }


                .login-card-logo img {
                    height: 78px;
                }


                .login-heading {
                    font-size: 26px;
                }


                .login-subtext {
                    margin-bottom: 26px;
                }


                .social-buttons {
                    grid-template-columns: 1fr;
                }


                .form-options {
                    font-size: 12px;
                }
            }

    </style>

</head>


<body>


    <!-- =========================================================
         NAVIGATION
         ========================================================= -->

    <header class="login-header">

        <div class="login-header-inner">


            <!-- Logo -->

            <a href="/"
               class="login-logo">

                <img src="~/images/murendeni side logo.png"
                     alt="Murendeni Construction Architects"
                     class="login-logo-image" />

            </a>


            <!-- Navigation -->

            <nav class="login-nav">

                <a href="/">
                    Home
                </a>

                <a href="/Portfolio">
                    Portfolio
                </a>

                <a href="/Services">
                    Services
                </a>

                <a href="/About">
                    About
                </a>

                <a href="/Contact">
                    Contact
                </a>

                <a href="/Account/Login"
                   class="login-nav-login">
                    Login
                </a>

                <a href="/Contact"
                   class="login-nav-contact">
                    Get in Touch
                </a>

            </nav>

        </div>

    </header>



    <!-- =========================================================
         LOGIN PAGE
         ========================================================= -->

    <main class="login-page">


        <!-- Login content -->

        <div class="login-content">

            <div class="login-card">


                <!-- Logo -->

                <div class="login-card-logo">

                    <img src="~/images/murendeni side logo.png"
                         alt="Murendeni Construction Architects" />

                </div>


                <!-- Heading -->

                <h1 class="login-heading">
                    Welcome Back
                </h1>


                <p class="login-subtext">
                    Please sign in to your account
                </p>


                <!-- Error -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="field-error">
                        @Model.ErrorMessage
                    </div>
                }


                <!-- Login Form -->

                <form method="post"
                      class="login-form">


                    <!-- Email -->

                    <div class="form-group">

                        <label asp-for="Input.Email">
                            Email
                        </label>


                        <div class="input-wrapper">

                            <input asp-for="Input.Email"
                                   type="email"
                                   placeholder="you@example.com"
                                   autocomplete="email" />


                            <svg class="input-icon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8">

                                <rect x="3"
                                      y="5"
                                      width="18"
                                      height="14"
                                      rx="2">
                                </rect>

                                <path d="M3 7l9 6 9-6">
                                </path>

                            </svg>

                        </div>

                    </div>



                    <!-- Password -->

                    <div class="form-group">

                        <label asp-for="Input.Password">
                            Password
                        </label>


                        <div class="input-wrapper">

                            <input asp-for="Input.Password"
                                   id="passwordInput"
                                   type="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />


                            <button type="button"
                                    class="password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password">

                                <svg id="eyeIcon"
                                     width="20"
                                     height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">

                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z">
                                    </path>

                                    <circle cx="12"
                                            cy="12"
                                            r="2.5">
                                    </circle>

                                </svg>

                            </button>

                        </div>

                    </div>



                    <!-- Remember / Forgot -->

                    <div class="form-options">

                        <label class="checkbox-label">

                            <input type="checkbox"
                                   name="RememberMe"
                                   value="true" />

                            <span>
                                Remember Me
                            </span>

                        </label>


                        <a href="/Account/ForgotPassword">
                            Forgot Password?
                        </a>

                    </div>



                    <!-- Login -->

                    <button type="submit"
                            class="login-button">

                        Login

                    </button>

                </form>



                <!-- Divider -->

                <div class="login-divider">

                    <span>
                        or continue with
                    </span>

                </div>



                <!-- Social Login -->

                <div class="social-buttons">


                    <button type="button"
                            class="social-button">

                        <span class="google-icon">
                            G
                        </span>

                        <span>
                            Google
                        </span>

                    </button>


                    <button type="button"
                            class="social-button">

                        <span class="apple-icon">
                            ●
                        </span>

                        <span>
                            Apple
                        </span>

                    </button>

                </div>



                <!-- Sign Up -->

                <div class="login-signup">

                    Don't have an account?

                    <a href="/Account/Register">
                        Sign Up
                    </a>

                </div>


            </div>

        </div>


    </main>



    <!-- =========================================================
         PASSWORD SHOW / HIDE
         ========================================================= -->

    <script>

            const passwordInput =
                document.getElementById("passwordInput");

            const passwordToggle =
                document.getElementById("passwordToggle");

            const eyeIcon =
                document.getElementById("eyeIcon");


            if (passwordToggle && passwordInput) {

                passwordToggle.addEventListener("click", function() {

                    const isPassword =
                        passwordInput.type === "password";


                    passwordInput.type =
                        isPassword ? "text" : "password";


                    passwordToggle.setAttribute(
                        "aria-label",
                        isPassword
                            ? "Hide password"
                            : "Show password"
                    );


                    if (isPassword) {

                        eyeIcon.innerHTML = `

                                    <path d="M3 3l18 18">
                                    </path>

                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8">
                                    </path>

                                    <path d="M9.9 5.2A10.5 10.5 0 0 1 12 5c6.5 0 10 7 10 7a18.8 18.8 0 0 1-3.2 3.8">
                                    </path>

                                    <path d="M6.2 6.2C3.6 8.1 2 12 2 12s3.5 7 10 7a9.8 9.8 0 0 0 4-.8">
                                    </path>

                                `;

                    }
                    else {

                        eyeIcon.innerHTML = `

                                    <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z">
                                    </path>

                                    <circle cx="12"
                                            cy="12"
                                            r="2.5">
                                    </circle>

                                `;

                    }

                });

            }

    </script>


</body>

</html>