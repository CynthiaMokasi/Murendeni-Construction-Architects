@page
@model AboutModel
@{
    ViewData["Title"] = "About Us";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container hero-layout">
        <div class="hero-content">
            <span class="hero-tag">ABOUT US</span>

            <h1 class="hero-title">
                Who We Are.<br>
                <span class="accent-text">What We Build.</span>
            </h1>

            <p class="hero-description">
                Get to know Murendeni Construction Architects and discover
                the people, values, and expertise behind our architectural
                drafting and design work.
            </p>

        </div>
    </div>

    <div class="scroll-indicator">
        <div class="scroll-icon">↓</div>
    </div>
</section>

<section class="section">
    <div class="container grid grid-2" style="align-items:start;">
        <div class="team-image">
            <img src="~/images/Team_Picture.jpeg"
                 alt="Murendeni Construction Architects Team">
        </div>

        <div>
            <h2>Who We Are</h2>
            <p>
                Murendeni Construction Architects is a Johannesburg-based architectural
                practice offering drafting, design and 3D visualisation services to
                homeowners, developers and businesses across Gauteng. We work with
                clients from the first sketch through to construction-ready
                documentation.
            </p>

            <h3>Our Mission</h3>
            <p>
                To make good architectural design accessible - combining technical
                accuracy with a design process that keeps clients informed at every
                stage.
            </p>

            <h3>Our Vision</h3>
            <p>
                To be one of Gauteng's most trusted names in residential and
                commercial architectural design.
            </p>

            <h3>Why Choose Us</h3>
            <ul>
                <li>Experienced professionals</li>
                <li>High quality designs</li>
                <li>On-time delivery</li>
                <li>Client satisfaction, from first plan to final approval</li>
            </ul>
        </div>
    </div>
</section>

<section class="stat-band">
    <div class="container stat-grid">
        <div>
            <div class="stat-number">10+</div>
            <div class="stat-label">Years Experience</div>
        </div>
        <div>
            <div class="stat-number">250+</div>
            <div class="stat-label">Projects Completed</div>
        </div>
        <div>
            <div class="stat-number">180+</div>
            <div class="stat-label">Happy Clients</div>
        </div>
        <div>
            <div class="stat-number">15+</div>
            <div class="stat-label">Awards Won</div>
        </div>
    </div>
</section>
