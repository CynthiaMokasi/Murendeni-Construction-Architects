<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-body">

    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-logo">
                <img src="~/images/murendeni main logo.png" alt="Murendeni Logo" />
                <span>Admin</span>
            </div>

            @{
                var currentRole = User.FindFirst("role")?.Value;
            }

            <nav>
                <a href="/Admin">Dashboard</a>

                @if (currentRole == "Admin" || currentRole == "Sales")
                {
                    <a href="/Admin/ManageClients">Manage Clients</a>
                    <a href="/Admin/ManageProjects">Manage Projects</a>
                    <a href="/Admin/ManageInquiries">Manage Inquiries</a>
                }

                @if (currentRole == "Admin")
                {
                    <a href="/Admin/ManageEmployees">Manage Employees</a>
                    <a href="/Admin/ManagePortfolio">Manage Portfolio</a>
                    <a href="/Admin/Reports">Reports</a>
                }

                @if (currentRole == "Admin" || currentRole == "Designer")
                {
                    <a href="/Admin/MyProjects">My Projects</a>
                    <a href="/Admin/UploadDesignFile">Upload Design Files</a>
                }
            </nav>

            <div class="admin-user">
                <div class="admin-user-info">
                    <div class="admin-user-avatar">
                        @{
                            var displayName = User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value ?? "Admin";
                        }
                        @displayName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="admin-user-name">@displayName</div>
                </div>
                <div class="admin-user-links">
                    <a href="/Admin/ChangePassword" class="admin-user-link">
                        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a4 4 0 00-4 4v2H5a1 1 0 00-1 1v7a1 1 0 001 1h10a1 1 0 001-1v-7a1 1 0 00-1-1h-1V6a4 4 0 00-4-4zm-2 6V6a2 2 0 114 0v2H8z" fill="currentColor" /></svg>
                        Change Password
                    </a>
                    <a href="/Account/Logout" class="admin-user-link admin-user-link-danger">
                        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 3a1 1 0 000 2h6a1 1 0 011 1v8a1 1 0 01-1 1H7a1 1 0 100 2h6a3 3 0 003-3V6a3 3 0 00-3-3H7z" fill="currentColor" /><path d="M9.7 6.3a1 1 0 00-1.4 1.4L9.6 9H3a1 1 0 100 2h6.6l-1.3 1.3a1 1 0 101.4 1.4l3-3a1 1 0 000-1.4l-3-3z" fill="currentColor" /></svg>
                        Logout
                    </a>
                </div>
            </div>
        </aside>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>