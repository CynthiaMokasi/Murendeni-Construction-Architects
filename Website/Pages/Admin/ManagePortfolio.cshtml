@page
@model MurendeniConstructionArchitects.Pages.Admin.ManagePortfolioModel
@{
    ViewData["Title"] = "Manage Portfolio";
}

<div class="admin-page-header">
    <h1>Manage Portfolio</h1>
    <a href="/Admin/AddProject" class="admin-btn admin-btn-accent">+ Add Project</a>
</div>

<p style="color:#666; margin-top:-14px; margin-bottom:24px;">
    Only <strong>Published</strong> projects appear on the public Portfolio page.
</p>

@if (Model.Projects.Count == 0)
{
    <div class="admin-empty">No projects yet.</div>
}
else
{
    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;">
        @foreach (var project in Model.Projects)
        {
            <div class="admin-stat-card" style="padding:0; overflow:hidden;">

                @if (!string.IsNullOrEmpty(project.CoverImageUrl))
                {
                    <img src="@project.CoverImageUrl" alt="@project.ProfileName"
                         style="width:100%; aspect-ratio:4/3; object-fit:cover;" />
                }
                else
                {
                    <div style="width:100%; aspect-ratio:4/3; background:#eee; display:flex; align-items:center; justify-content:center; color:#999; font-size:0.85rem;">
                        No cover image
                    </div>
                }

                <div style="padding:16px;">
                    <span class="badge badge-@(project.IsPublished ? "completed" : "closed")">
                        @(project.IsPublished ? "Published" : "Not Published")
                    </span>
                    <h3 style="margin:8px 0 4px 0; font-size:1rem;">@project.ProfileName</h3>
                    <p style="color:#777; font-size:0.85rem; margin-bottom:14px;">@project.PropertyType &middot; @(project.Location ?? "No location set")</p>

                    <div style="display:flex; gap:8px;">
                        <a href="/Admin/EditProject/@project.ProfileId" class="admin-btn admin-btn-outline" style="flex:1; text-align:center;">Edit</a>

                        <form method="post" asp-page-handler="TogglePublish" asp-route-id="@project.ProfileId" style="flex:1;">
                            <button type="submit" class="admin-btn admin-btn-accent" style="width:100%;">
                                @(project.IsPublished ? "Unpublish" : "Publish")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}